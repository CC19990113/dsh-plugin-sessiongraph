{
  "name": "dsh-plugin-sessiongraph-tool",
  "version": "0.2.0",
  "description": "Model-facing tool for DeepSeek Harness — one read-only `sessiongraph` tool with eight operations: full-text search over local conversation history (Chinese bigram), single-session reads, unabridged event reads, lineage and event tracing, timeline/workspace census, and index runs that delegate to a host background job on large stores",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "session",
    "session-history",
    "conversation",
    "search",
    "fts",
    "ai-agent",
    "llm-tools",
    "agent-tools"
  ],
  "license": "MIT",
  "author": "CC ZHAO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CC19990113/dsh-plugin-sessiongraph.git",
    "directory": "packages/tool"
  },
  "homepage": "https://github.com/CC19990113/dsh-plugin-sessiongraph#readme",
  "bugs": "https://github.com/CC19990113/dsh-plugin-sessiongraph/issues",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "dsh-plugin-sessiongraph-service": "workspace:^",
    "dsh-plugin-sessiongraph-sessions": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  }
}
