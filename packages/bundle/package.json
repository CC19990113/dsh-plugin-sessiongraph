{
  "name": "dsh-plugin-sessiongraph",
  "version": "0.1.19",
  "description": "Bundle for the sessiongraph capability — install this package to add local conversation-history search to a DeepSeek Harness profile",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "bundle",
    "sessiongraph",
    "session-history"
  ],
  "license": "MIT",
  "author": "CC ZHAO",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CC19990113/dsh-plugin-sessiongraph.git",
    "directory": "packages/bundle"
  },
  "homepage": "https://github.com/CC19990113/dsh-plugin-sessiongraph#readme",
  "bugs": "https://github.com/CC19990113/dsh-plugin-sessiongraph/issues",
  "type": "module",
  "files": [
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "dependencies": {
    "dsh-plugin-sessiongraph-service": "workspace:^",
    "dsh-plugin-sessiongraph-sessions": "workspace:^",
    "dsh-plugin-sessiongraph-sqlite": "workspace:^",
    "dsh-plugin-sessiongraph-tool": "workspace:^"
  },
  "scripts": {
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md','README.md')\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
